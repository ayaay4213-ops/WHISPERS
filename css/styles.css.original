:root { --gold: #d4af37; --ink: #140726; }
html, body { background: #0d0418; -webkit-tap-highlight-color: transparent; }
.app-width, .app-shell { max-width: 480px; width: 100%; }
@media (min-width: 481px) { .app-shell { border-inline: 1px solid #2a1249; } }
.pb-safe { padding-bottom: env(safe-area-inset-bottom); }
.has-tabbar { padding-bottom: calc(76px + env(safe-area-inset-bottom)); }

.tab { display: flex; flex-direction: column; align-items: center; gap: 3px; padding: 10px 0 9px; color: #9a86b8; font-size: 11px; font-weight: 500; transition: color .15s; }
.tab svg { width: 22px; height: 22px; stroke-width: 1.8; }
.tab.active { color: var(--gold); }
.tab.active svg { stroke-width: 2.2; }

.btn-gold { background: var(--gold); color: #1d0b36; font-weight: 700; border-radius: 14px; padding: 13px 18px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; transition: background .15s, transform .1s; }
.btn-gold:hover { background: #e6c35c; }
.btn-gold:active { transform: scale(.98); }
.btn-gold:disabled { opacity: .5; pointer-events: none; }
.btn-ghost { border: 1px solid #3a1d5c; color: #eadff8; border-radius: 14px; padding: 12px 16px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; transition: background .15s; }
.btn-ghost:hover { background: #1d0b36; }
.btn-danger { border: 1px solid #5c1d34; color: #f4a3b8; border-radius: 14px; padding: 12px 16px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; }
.btn-danger:hover { background: #2a0f1d; }

.card { background: #1d0b36; border: 1px solid #2a1249; border-radius: 18px; }
.field { width: 100%; background: #0d0418; border: 1px solid #3a1d5c; border-radius: 12px; padding: 12px 14px; color: #fff; outline: none; transition: border-color .15s; font-size: 15px; }
.field:focus { border-color: var(--gold); }
.field::placeholder { color: #6e5a8c; }
.label { display: block; font-size: 13px; color: #bba9d6; margin-bottom: 6px; font-weight: 500; }

.chip { font-size: 12px; padding: 6px 12px; border-radius: 999px; border: 1px solid #3a1d5c; color: #cbb9e6; white-space: nowrap; }
.chip.active { background: var(--gold); border-color: var(--gold); color: #1d0b36; font-weight: 700; }
.badge-soon { font-size: 11px; padding: 3px 8px; border-radius: 999px; background: #2a1249; color: #e6c35c; border: 1px solid #5b3a85; }

.avatar { display: flex; align-items: center; justify-content: center; border-radius: 999px; font-weight: 800; color: #fff; flex-shrink: 0; }
.ornament { background-image: radial-gradient(circle at 1px 1px, rgba(212,175,55,.12) 1px, transparent 0); background-size: 18px 18px; }

.toast { position: fixed; left: 50%; top: 18px; transform: translate(-50%, -20px); background: #2a1249; border: 1px solid #5b3a85; color: #fff; padding: 11px 18px; border-radius: 14px; font-size: 14px; opacity: 0; pointer-events: none; transition: all .25s; z-index: 60; max-width: 90vw; text-align: center; }
.toast.show { opacity: 1; transform: translate(-50%, 0); }
.toast.error { border-color: #8a2a4a; background: #2a0f1d; }

.sheet-backdrop { position: fixed; inset: 0; background: rgba(5,1,12,.7); z-index: 40; animation: fade .2s; }
.sheet { position: fixed; bottom: 0; left: 50%; transform: translateX(-50%); width: 100%; max-width: 480px; background: #1d0b36; border-top: 1px solid #3a1d5c; border-radius: 24px 24px 0 0; z-index: 41; padding: 10px 20px calc(24px + env(safe-area-inset-bottom)); animation: up .25s ease-out; max-height: 90dvh; overflow-y: auto; }
@keyframes up { from { transform: translate(-50%, 100%); } to { transform: translate(-50%, 0); } }
@keyframes fade { from { opacity: 0; } to { opacity: 1; } }

.spinner { width: 28px; height: 28px; border: 3px solid #3a1d5c; border-top-color: var(--gold); border-radius: 50%; animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.skeleton { background: #22103d; border-radius: 12px; animation: pulse 1.4s ease-in-out infinite; }
@keyframes pulse { 50% { opacity: .5; } }
.no-scrollbar::-webkit-scrollbar { display: none; }
.no-scrollbar { scrollbar-width: none; }
.fade-in { animation: fade .25s; }
